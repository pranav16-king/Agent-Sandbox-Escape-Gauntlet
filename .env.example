# ==============================================================================
# Agent Sandbox Escape Gauntlet (PS01) - Environment Configuration Template
# Copy this file to '.env' and customize values for your deployment.
# ==============================================================================

# Application Metadata & Server
APP_NAME="Agent Sandbox Escape Gauntlet - Host Gateway"
VERSION="0.1.0"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Security Credentials & Tokens (Change these to strong random strings in production!)
AGENT_AUTH_TOKEN="gauntlet-agent-secret-key-2026"
HMAC_SECRET_KEY="sbx-gauntlet-hmac-host-key-sha256"
POLICY_HASH="v1-opa-rego-sha256-strict"

# Execution Engine & Container Isolation
USE_DOCKER=true
DOCKER_IMAGE="sbx-image:latest"
DOCKER_NETWORK="sbx_internal"
DOCKER_DNS="10.10.0.2"

# Process & Resource Limits
DEFAULT_TIMEOUT_SEC=10
MAX_STDOUT_BYTES=20480
MAX_STDERR_BYTES=5120

# Local LLM (Ollama) Configuration
OLLAMA_API_URL="http://127.0.0.1:11434/api/chat"
MODEL_NAME="qwen3:4b"

# Replay Mode (Set to true to use deterministic transcripts when local LLM is offline)
REPLAY_MODE=false
